00003414  4E75                     392  HUDEND:     RTS
00003416                           393  
00003416                           394  *-----------------------------------------------------------
00003416                           395  * COLLISION - 50/50 shield damage check used by exp1 and exp3
00003416                           396  * a random number below 128 means the shockwave connects for 25 damage
00003416                           397  * 128 or above means the impact was avoided
00003416                           398  *-----------------------------------------------------------
00003416  6100 00CA                399  COLLISION:  BSR     RANDOM              * generate a random number 0 to 255
0000341A  B07C 0080                400              CMP.W   #128,D0             * check if it falls in the safe range
0000341E  6C00 0020                401              BGE     CMISS               * 128 or above, no damage taken
00003422  43F9 000041F2            402              LEA     HIT_MSG,A1          * print the shockwave hit message
00003428  103C 000E                403              MOVE.B  #14,D0
0000342C  4E4F                     404              TRAP    #15
0000342E  3038 4000                405              MOVE.W  $4000,D0            * load shields
00003432  0440 0019                406              SUB.W   #25,D0              * apply 25 damage
00003436  6100 0090                407              BSR     CAP                 * clamp so shields do not go below 0
0000343A  31C0 4000                408              MOVE.W  D0,$4000            * save updated shields
0000343E  4E75                     409              RTS
00003440  43F9 00004228            410  CMISS:      LEA     MISS_MSG,A1         * print the avoided hit message
00003446  103C 000E                411              MOVE.B  #14,D0
0000344A  4E4F                     412              TRAP    #15
0000344C  4E75                     413              RTS
0000344E                           414  
0000344E                           415  *-----------------------------------------------------------
0000344E                           416  * CHECKDEAD - checks all three resources for zero
0000344E                           417  * if any resource is at or below zero the game ends
0000344E                           418  *-----------------------------------------------------------
0000344E  3038 4000                419  CHECKDEAD:  MOVE.W  $4000,D0            * load shields
00003452  B07C 0000                420              CMP     #0,D0
00003456  6F00 001C                421              BLE     GAMEOVER            * shields at zero, game over
0000345A  3038 4002                422              MOVE.W  $4002,D0            * load plasma
0000345E  B07C 0000                423              CMP     #0,D0
00003462  6F00 0010                424              BLE     GAMEOVER            * plasma at zero, game over
00003466  3038 4004                425              MOVE.W  $4004,D0            * load dark matter
0000346A  B07C 0000                426              CMP     #0,D0
0000346E  6F00 0004                427              BLE     GAMEOVER            * dark matter at zero, game over
00003472  4E75                     428              RTS                         * all resources above zero, continue
00003474                           429  
00003474                           430  *-----------------------------------------------------------
00003474                           431  * GAMEOVER - displays the end screen and halts the simulation
00003474                           432  * shows the scientist portrait, a failure message, and the final day count
00003474                           433  *-----------------------------------------------------------
00003474  6100 00AE                434  GAMEOVER:   BSR     CLEAR_SCREEN        * clear screen for the game over display
00003478  43F9 0000377A            435              LEA     SCIENTIST_ART,A1    * print the scientist portrait
0000347E  103C 000E                436              MOVE.B  #14,D0
00003482  4E4F                     437              TRAP    #15
00003484  43F9 000043D6            438              LEA     DEAD_MSG,A1         * print the game over banner
0000348A  103C 000E                439              MOVE.B  #14,D0
0000348E  4E4F                     440              TRAP    #15
00003490  43F9 000044A2            441              LEA     SCORE_MSG,A1        * print the final score label
00003496  103C 000E                442              MOVE.B  #14,D0
0000349A  4E4F                     443              TRAP    #15
0000349C  3238 4006                444              MOVE.W  $4006,D1            * load the final day count
000034A0  103C 0003                445              MOVE.B  #3,D0              * print it as an integer
000034A4  4E4F                     446              TRAP    #15
000034A6  FFFF FFFF                447              SIMHALT                     * halt the simulation
000034AA                           448  
000034AA                           449  *-----------------------------------------------------------
000034AA                           450  * REPLAY - end of turn prompt asking the player to continue or quit
000034AA                           451  * entering 0 exits to END, anything else restarts the game loop
000034AA                           452  * uses BRA instead of BSR to avoid growing the call stack each turn
000034AA                           453  *-----------------------------------------------------------
000034AA  43F9 000044C5            454  REPLAY:     LEA     REPLAY_MSG,A1       * print the replay prompt
000034B0  103C 000E                455              MOVE.B  #14,D0
000034B4  4E4F                     456              TRAP    #15
000034B6  103C 0004                457              MOVE.B  #4,D0              * read player input
000034BA  4E4F                     458              TRAP    #15
000034BC  B27C 0000                459              CMP     #EXIT,D1            * check if the player entered 0
000034C0  6700 FB3E                460              BEQ     END                 * if so, jump to END and halt
000034C4  6000 FB5C                461              BRA     GAMELOOP            * otherwise restart the game loop
000034C8                           462  
000034C8                           463  *-----------------------------------------------------------
000034C8                           464  * CAP - clamps the value in D0 to the range 0 to 100
000034C8                           465  * call this before saving any resource value back to memory
000034C8                           466  *-----------------------------------------------------------
000034C8  B07C 0064                467  CAP:        CMP     #100,D0             * check if value exceeds the maximum
000034CC  6F00 0006                468              BLE     CAPLO               * within range, check the lower bound
000034D0  303C 0064                469              MOVE.W  #100,D0             * value too high, force it to 100
000034D4  B07C 0000                470  CAPLO:      CMP     #0,D0               * check if value is below zero
000034D8  6C00 0006                471              BGE     CAPOK               * value is fine, return
000034DC  303C 0000                472              MOVE.W  #0,D0              * value too low, force it to 0
000034E0  4E75                     473  CAPOK:      RTS
000034E2                           474  
000034E2                           475  *-----------------------------------------------------------
000034E2                           476  * RANDOM - linear congruential generator
000034E2                           477  * formula: seed = (seed * 75 + 74) AND 255
000034E2                           478  * returns a value between 0 and 255 in D0
000034E2                           479  * CLR.L clears the full 32 bit register before loading the seed
000034E2                           480  * skipping this causes leftover bits in the upper word to corrupt the multiply result
000034E2                           481  *-----------------------------------------------------------
000034E2  4280                     482  RANDOM:     CLR.L   D0                  * clear the full 32 bit register, not just the lower word
000034E4  3038 4008                483              MOVE.W  $4008,D0            * load the current seed
000034E8  C0FC 004B                484              MULU    #75,D0              * multiply by the lcg multiplier
000034EC  0640 004A                485              ADD.W   #74,D0              * add the lcg increment
000034F0  C07C 00FF                486              AND.W   #$00FF,D0           * mask to 8 bits, keeping the result in range 0 to 255
000034F4  31C0 4008                487              MOVE.W  D0,$4008            * save the new seed for next time
000034F8  4E75                     488              RTS
000034FA                           489  
000034FA                           490  *-----------------------------------------------------------
000034FA                           491  * CONTINUE - prints a prompt and blocks until the player presses a key
000034FA                           492  * placed after every major screen so the player has time to read it
000034FA                           493  *-----------------------------------------------------------
000034FA                           494  CONTINUE:
000034FA  43F9 00003535            495              LEA     CONTINUE_MSG,A1     * load the continue prompt
00003500  103C 000E                496              MOVE.B  #14,D0
00003504  4E4F                     497              TRAP    #15
00003506  103C 0004                498              MOVE.B  #4,D0              * trap 4 blocks here until the player enters something
0000350A  4E4F                     499              TRAP    #15
0000350C  4E75                     500              RTS
0000350E                           501  
0000350E                           502  *-----------------------------------------------------------
0000350E                           503  * ENDL - prints a newline
0000350E                           504  * saves and restores D0 and A1 so it does not interfere with the caller
0000350E                           505  *-----------------------------------------------------------
0000350E                           506  ENDL:
0000350E  48E7 8040                507              MOVEM.L D0/A1,-(A7)         * push D0 and A1 onto the stack
00003512  303C 000E                508              MOVE    #14,D0              * trap 14 prints a string
00003516  43F9 00003532            509              LEA     CRLF,A1             * point A1 at the newline bytes
0000351C  4E4F                     510              TRAP    #15
0000351E  4CDF 0201                511              MOVEM.L (A7)+,D0/A1         * restore D0 and A1 from the stack
00003522  4E75                     512              RTS
00003524                           513  
00003524                           514  *-----------------------------------------------------------
00003524                           515  * CLEAR_SCREEN - clears the easy68k output window
00003524                           516  *-----------------------------------------------------------
00003524                           517  CLEAR_SCREEN:
00003524  103C 000B                518              MOVE.B  #11,D0              * trap 11 is the display control trap
00003528  323C FF00                519              MOVE.W  #$FF00,D1           * $FF00 is the command code to clear the screen
0000352C  4E4F                     520              TRAP    #15
0000352E  4E75                     521              RTS
